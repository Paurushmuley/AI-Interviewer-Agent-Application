# -------------------------------------------------------------
# AI Interviewer - Environment Variables Configuration
# -------------------------------------------------------------

# PostgreSQL Database (Supabase / Neon / Vercel Postgres)
# Runtime Pooled Connection (port 6543 / pgbouncer)
POSTGRES_PRISMA_URL="postgres://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"

# Direct Non-Pooled Connection for Migrations & Schema Push (port 5432)
POSTGRES_URL_NON_POOLING="postgres://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"

# Standard Fallback Database URL
DATABASE_URL="postgres://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require"

# Authentication & Session Secret (Generate with: openssl rand -base64 32)
JWT_SECRET="replace-with-a-secure-random-32-byte-secret"

# Master Encryption Key for BYOK AES-256-GCM encryption (32 bytes hex)
# e.g., run in node: require('crypto').randomBytes(32).toString('hex')
ENCRYPTION_MASTER_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Vercel Blob Storage Token (For temporary resume uploads)
# In production on Vercel, this is automatically injected when you attach Vercel Blob
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Public App URL
NEXT_PUBLIC_APP_URL="http://localhost:5000"

# Optional Supabase Client Keys (if using Supabase Auth or Realtime)
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhb..."

# Local Ollama Sub-Agent URL (for offline local model testing)
OLLAMA_BASE_URL="http://127.0.0.1:11434"

# Optional External BYOK Defaults (Users can also enter keys in UI)
OPENAI_API_KEY=""
GEMINI_API_KEY=""
GROQ_API_KEY=""
ANTHROPIC_API_KEY=""
