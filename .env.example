# -------------------------------------------------------------
# AI Interviewer - Environment Variables Configuration
# -------------------------------------------------------------

# PostgreSQL Connection URL (Neon / Supabase / Vercel Postgres / Local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_interviewer?schema=public"

# Authentication & Session Secret (Generate with: openssl rand -base64 32)
JWT_SECRET="replace-with-a-secure-random-32-byte-secret"

# Master Encryption Key for BYOK AES-256-GCM encryption (32 bytes hex)
# e.g., run in node: require('crypto').randomBytes(32).toString('hex')
ENCRYPTION_MASTER_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Vercel Blob Storage Token (For resume uploads)
# In production on Vercel, this is automatically injected when you attach Vercel Blob
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_sample_token"

# Public App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -------------------------------------------------------------
# Optional Default LLM Keys (Users can also provide keys via BYOK)
# -------------------------------------------------------------
OPENAI_API_KEY=""
GEMINI_API_KEY=""
GROQ_API_KEY=""
ANTHROPIC_API_KEY=""

# Local Ollama Sub-Agent URL (for offline local model testing)
OLLAMA_BASE_URL="http://127.0.0.1:1434"
